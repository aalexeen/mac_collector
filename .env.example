# -------------------------------------------------------
# MAC Collector — configuration
# Copy this file to .env and edit before running:
#   cp .env.example .env
#   docker compose -f docker/docker-compose.yml up --build
# -------------------------------------------------------

# SNMP v2c community string for your switches
SNMP_COMMUNITY=public

# How often to poll switches (seconds). Default: 300 (5 min)
COLLECT_INTERVAL=300

# Timezone for the web UI (IANA name). Default: America/New_York
DISPLAY_TZ=America/New_York

# Admin credentials created on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Session secret — used to sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-secret

# PostgreSQL password
# Generate with: openssl rand -hex 16
DB_PASSWORD=change-me-db-password
