# -------------------------------------------------------
# MAC Collector — demo configuration
# Copy this file to .env and edit before running:
#   cp .env.example .env
#   docker compose up
# -------------------------------------------------------

# SNMP v2c community string for your switches
SNMP_COMMUNITY=public

# How often to poll switches (seconds). Default: 300 (5 min)
COLLECT_INTERVAL=300

# Timezone for the web UI (IANA name). Default: America/New_York
DISPLAY_TZ=America/New_York

# Admin credentials created on first start
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=admin
